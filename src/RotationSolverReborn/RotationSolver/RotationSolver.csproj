		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<OutputPath>$(SolutionDir)bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="ECommons"><HintPath>C:/Users/earth/AppData/Roaming/XIVLauncher/installedPlugins/RotationSolver/7.5.7.15/ECommons.dll</HintPath></Reference>

		<PackageReference Include="RebornMaterial" Version="7.5.7.6" />
		
